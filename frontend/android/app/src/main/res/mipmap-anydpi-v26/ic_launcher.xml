<?xml version="1.0" encoding="utf-8"?>
<!--
  No <inset> here on purpose. The 108dp foreground PNGs generated by
  scripts/branding/generate_icons.py already place the artwork inside the
  72dp safe zone, because the mask guarantees only that much survives. The
  template's default 16% inset would then apply on top and shrink the
  wordmark to the point of illegibility.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_background"/>
  <foreground android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
